        copyto: src/td_queue_pkg.vhd
    - ../uvvm_vvc_framework/src_target_dependent/td_vvc_entity_support_pkg.vhd:
        copyto: src/td_vvc_entity_support_pkg.vhd
    - ./src/uart_rx_vvc.vhd
    - ./src/uart_tx_vvc.vhd
    - ./src/uart_vvc.vhd
    - ./src/uart_monitor.vhd
    - ./src/vvc_context.vhd
    file_type: vhdlSource-2008
