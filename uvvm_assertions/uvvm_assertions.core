CAPI=2:
name: uvvm:uvvm:uvvm_assertions:0.1.2
filesets:
  rtl:
    files:
    - ./src/uvvm_assertions_pkg.vhd
    file_type: vhdlSource-2008
    logical_name: uvvm_assertions
    depend:
    - uvvm:uvvm:uvvm_util:2.22.0
  tb:
    files:
    - ./tb/demo_entities.vhd
    - ./tb/uvvm_assertions_demo_th.vhd
    - ./tb/uvvm_assertions_demo_tb.vhd
    file_type: vhdlSource-2008
    logical_name: uvvm_assertions
    depend:
    - uvvm:uvvm:uvvm_util:2.22.0
targets:
  default:
    filesets:
    - rtl
  sim:
    filesets:
    - rtl
    - tb
    toplevel: uvvm_assertions.uvvm_assertions_demo_tb
    default_tool: ghdl
    tools:
      ghdl:
        analyze_options:
        - -frelaxed
