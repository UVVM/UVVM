CAPI=2:
name: uvvm:uvvm:bitvis_irqc:1.0.15
filesets:
  rtl:
    files:
    - ./src/irqc_pif_pkg.vhd
    - ./src/irqc_pif.vhd
    - ./src/irqc_core.vhd
    - ./src/irqc.vhd
    file_type: vhdlSource-2008
    logical_name: bitvis_irqc
  tb:
    files:
    - ./tb/irqc_demo_tb.vhd
    file_type: vhdlSource-2008
    logical_name: bitvis_irqc
    depend:
    - uvvm:uvvm:bitvis_vip_sbi:4.1.4
    - uvvm:uvvm:uvvm_util:2.22.0
targets:
  default:
    filesets:
    - rtl
  sim:
    filesets:
    - rtl
    - tb
    toplevel: bitvis_irqc.irqc_demo_tb
    default_tool: ghdl
    tools:
      ghdl:
        analyze_options:
        - -frelaxed
